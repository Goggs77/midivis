cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'midivis' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               midivis

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           creative midi visualizer

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             Goggs

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         the801140@outlook.com

-- A copyright notice.
-- copyright:
category:           Music
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall
                 -threaded
                 -O2
                 -optl-s
                 -optc-Os
                 -static
                 -optl-static
                 -optl-pthread
                 -optl-Wl,--gc-sections

library
    -- Import common warning flags.
    import:           warnings

    -- Modules exported by the library.
    exposed-modules:    Midivis.World,
                        Midivis.Render.Example,
                        Midivis.Render.ShaderFX,
                        Midivis.System.ExampleRenderer,
                        Midivis.System.MidiQuery,
                        Midivis.EventHandler,
                        Midivis.Midi.MidiParser,
                        Midivis.Midi.MidiEventType,
                        Midivis.Tuning.TuningParser,
                        Midivis.Tuning.Scala,
                        Midivis.Tuning.Ascl,
                        Midivis.Tuning.Poly,
                        Midivis.Tuning.Corpus,
                        Midivis.Resources.Tuning.All,
                        Midivis.Resources.Audio.IR,
                        Midivis.Resources.Font,
                        Midivis.Synth.Engine,
                        Midivis.Synth.Types,
                        Midivis.Synth.Smooth,
                        Midivis.Synth.Render,
                        Midivis.Synth.VoicePool,
                        Midivis.Synth.Fft,
                        Midivis.Synth.ConvReverb,
                        Midivis.Synth.AlgorithmicReverb,
                        Midivis.Synth.WavLoader,
                        Midivis.Synth.CtrlBus,
                        Midivis.Synth.Preset,
                        Midivis.Synth.Eq,
                        Midivis.Synth.Sine,
                        Midivis.Synth.ModMatrix,
                        Midivis.Synth.Chorus,
                        Midivis.Synth.Ensemble,
                        Midivis.Synth.Vibrato,
                        Midivis.Render.Text,
                        Midivis.Resources.Tuning.Default,
                        Midivis.Resources.Tuning.EDO,
                        Midivis.Resources.Tuning.JustIntonation,
                        Midivis.Resources.Tuning.Dastgah,
                        Midivis.Resources.Tuning.Extra,
                        Midivis.Util.THUtils,
                        Midivis.Util.Math,

    -- sorry but keep it ascii
    other-modules:      
                        
                        Midivis.Util.Text,
                        Midivis.Synth.KeyboardLayout,
                        Midivis.System.Selection,
                        Midivis.Resources.FontTH

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    -- We can't use GLFW-only since gloss always calls GLUT
    build-depends:    base ^>=4.20.1.0,
                      array,
                      gloss-relative-localmod,
                      gloss,
                      OpenGL,
                      random,
                      linear,
                      vector,
                      extra,
                      directory,
                      template-haskell,
                      binary,
                      bytestring,
                      file-embed,
                      text,
                      unordered-containers,
                      hashable,
                      vector-algorithms,
                      with-utf8,
                      universe-base,
                      -- audio processing
                      RtMidi,
                      storablevector, 
                      portaudio,
                      -- synthesizer for microtuning examples
                      synthesizer-core,
                      synthesizer-midi,
                      -- concurrent needs
                      stm^>=2.5.3.1,
                      -- utf-8 text rendering
                      freetype2,
                      containers,
                      -- no laziness
                      deepseq


    -- Directories containing source files.
    hs-source-dirs:   src\

    -- C++ DSP core (12-band EQ, cbits/Eq12.cpp).  Compiled with g++ and
    -- linked into the library; the C++ runtime (libstdc++) is pulled in
    -- automatically when cxx-sources are present.
    cxx-sources:      cbits/Eq12.cpp
    include-dirs:     cbits
    cxx-options:      -O3 -std=c++20

    -- Base language which the package is written in.
    default-language: Haskell2010

executable midivis
    -- Import common warning flags.
    import:           warnings

    -- Embed default RTS options into the executable:
    --   -N      use all cores
    --   -M256M  cap heap (prevents runaway growth / OOM)
    --   --nonmoving-gc   concurrent mark-sweep GC: avoids long copying GC
    --                    pauses on the large long-lived heap (fonts, IR,
    --                    delay lines) — important for the real-time audio
    --                    callback thread
    --   -A64m   larger allocation area: far fewer minor GCs per second,
    --                    at the cost of more heap between collections
    ghc-options:      -rtsopts=all
                      -with-rtsopts=-M256M
                      -with-rtsopts=--nonmoving-gc
                      -with-rtsopts=-A64m

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:
                      base ^>=4.20.1.0,
                      midivis,
                      RtMidi,
                      portaudio,
                      stm ^>=2.5.3.1,
                      storablevector,
                      directory,
                      array,
                      with-utf8

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: Haskell2010

test-suite midivis-test
    -- Import common warning flags.
    import:           warnings

    -- Base language which the package is written in.
    default-language: Haskell2010

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main_test.hs

    -- Test dependencies.
    build-depends:
                      base ^>=4.20.1.0,
                      midivis,
                      stm ^>=2.5.3.1,
                      vector,
                      gloss-relative-localmod

-- | Full-chain voicing test: drives the preset voices through every stage of
--   the signal chain and logs per-stage level monitoring to a .log file.
--   See test/fullchain/FullChainTest.hs.
test-suite fullchain-test
    import:           warnings

    default-language: Haskell2010

    type:             exitcode-stdio-1.0

    -- allow +RTS overrides at runtime (GC / allocation analysis)
    ghc-options:      -rtsopts=all

    hs-source-dirs:   test/fullchain

    main-is:          FullChainTest.hs

    build-depends:
                      base ^>=4.20.1.0,
                      midivis,
                      stm ^>=2.5.3.1,
                      array,
                      directory,
                      vector
